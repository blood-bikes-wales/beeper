# Copy to a gitignored tfvars file (see .gitignore). Use one file per environment, e.g.:
#   terraform.staging.tfvars
#   terraform.production.tfvars

project_id = "your-gcp-project-id"

three_rings_api_key = "your-three-rings-api-key"
twilio_account_sid  = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
twilio_auth_token   = "your-twilio-auth-token"
twilio_webhook_url  = "https://your-region-your-project.cloudfunctions.net/beeper"
