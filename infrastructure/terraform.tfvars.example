# Copy to a gitignored tfvars file (see .gitignore). Use one file per environment, e.g.:
#   terraform.staging.tfvars
#   terraform.production.tfvars

project_id = "your-gcp-project-id"

three_rings_api_key = "your-three-rings-api-key"
twilio_account_sid  = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
twilio_auth_token   = "your-twilio-auth-token"
gmail_client_id     = "your-oauth-client-id.apps.googleusercontent.com"
gmail_client_secret = "your-oauth-client-secret"
gmail_refresh_token = "your-gmail-refresh-token"
gmail_watch_user    = "you@example.com"
gmail_alert_from    = "biketrac@example.com"
