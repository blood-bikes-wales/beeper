THREE_RINGS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# GCP project ID used when connecting to live Cloud Datastore (npm run run).
# Not needed for local emulator dev (npm run dev sets this automatically).
GCP_PROJECT_ID=

# Full webhook URL exactly as configured in Twilio (required for local dev via ngrok).
# Must match character-for-character, including trailing slash and path.
# TWILIO_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/
# DATASTORE_EMULATOR_HOST=localhost:8081
# DATASTORE_PROJECT_ID=beeper-local