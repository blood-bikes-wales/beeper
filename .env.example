THREE_RINGS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Desktop OAuth client in the same GCP project. See docs/technical/gmail-push.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Printed by `npm run authorize-gmail`. Do not commit a real token.
GMAIL_REFRESH_TOKEN=
# Workspace address that owns the refresh token.
GMAIL_WATCH_USER=
# Sender whose plain-text body is forwarded by SMS.
GMAIL_ALERT_FROM=
# Set by Terraform in Cloud Functions. Required for local watch renewal.
# GMAIL_PUBSUB_TOPIC=projects/your-project/topics/beeper-gmail

# GCP project ID used when connecting to live Cloud Datastore (npm run run).
# Not needed for local emulator dev (npm run dev sets this automatically).
GCP_PROJECT_ID=

# Named Datastore database (production). Set automatically in Cloud Run via Terraform.
# DATASTORE_DATABASE_ID=beeper-database

# DATASTORE_EMULATOR_HOST=localhost:8081
# DATASTORE_PROJECT_ID=beeper-local
